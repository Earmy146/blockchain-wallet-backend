# =================================
# SERVER CONFIGURATION
# =================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# =================================
# DATABASE CONFIGURATION
# =================================
MONGODB_URI=mongodb://localhost:27017/blockchain-wallet
# Hoặc dùng MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/blockchain-wallet?retryWrites=true&w=majority

# =================================
# JWT AUTHENTICATION
# =================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# =================================
# ENCRYPTION (cho seed phrase)
# =================================
ENCRYPTION_KEY=your-32-character-encryption-key-here-change-this
# Lưu ý: Key này phải có độ dài 32 ký tự cho AES-256

# =================================
# ETHEREUM NETWORK - TESTNET
# =================================
# Sepolia Testnet (Khuyên dùng vì còn hoạt động)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_EXPLORER=https://sepolia.etherscan.io

# Goerli Testnet (Backup - sắp deprecated)
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_PROJECT_ID
GOERLI_CHAIN_ID=5
GOERLI_EXPLORER=https://goerli.etherscan.io

# =================================
# ETHEREUM NETWORK - MAINNET
# =================================
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
MAINNET_CHAIN_ID=1
MAINNET_EXPLORER=https://etherscan.io

# =================================
# RPC PROVIDER KEYS
# =================================
# Infura (https://infura.io)
INFURA_PROJECT_ID=your_infura_project_id_here
INFURA_PROJECT_SECRET=your_infura_secret_here

# Alchemy (Alternative - https://alchemy.com)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# =================================
# GAS CONFIGURATION
# =================================
DEFAULT_GAS_LIMIT=21000
MAX_GAS_PRICE_GWEI=50
GAS_PRICE_BUFFER=1.1

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# CORS CONFIGURATION
# =================================
CORS_ORIGIN=http://localhost:3000
# Nếu có nhiều origins:
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# =================================
# LOGGING
# =================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# =================================
# FAUCET (Testnet only - optional)
# =================================
# Sepolia Faucet: https://sepoliafaucet.com
# Goerli Faucet: https://goerlifaucet.com
FAUCET_ENABLED=true

# =================================
# EMAIL (Optional - cho reset password)
# =================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@blockchainwallet.com

# =================================
# SECURITY
# =================================
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=3600000

# =================================
# BACKUP & RECOVERY (Optional)
# =================================
BACKUP_ENCRYPTION_ENABLED=true
MIN_PASSWORD_LENGTH=8